al,sans-serif; box-sizing: border-box; font-size: 14px; width: 100%; background-color: #f6f6f6; margin: 0;\" bgcolor=\"#f6f6f6\">\n        <tr style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; margin: 0;\">\n            <td style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; vertical-align: top; margin: 0;\" valign=\"top\"></td>\n            <td class=\"container\" width=\"600\" style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; vertical-align: top; display: block !important; max-width: 600px !important; clear: both !important; margin: 0 auto;\" valign=\"top\">\n                <div class=\"content\" style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; max-width: 600px; display: block; margin: 0;\">\n                    <table class=\"main\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; border-radius: 3px; background-color: #fff; margin: 0; border: 1px solid #e9e9e9;\" bgcolor=\"#fff\">\n                        <tr style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; margin: 0;\">\n                            <td class=\"content-wrap\" style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; vertical-align: top; margin: 0; padding: 20px;\" valign=\"top\">\n                                <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; margin: 0;\">\n                                    <tr style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; margin: 0;\">\n                                        <td>\n                                            <img src=\"https://drive.google.com/uc?id=1HfiaGuNG6ZhZej4c7iUk6vr2QV9lUp3l\" style=\"width: 100%; padding-bottom: 15px;display: inline !important;vertical-align: bottom;border: 0;height: auto;outline: none;text-decoration: none;-ms-interpolation-mode: bicubic;\" />\n                                        </td>\n                                    </tr>\n                                    <tr style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; margin: 0;\">\n                                        <td class=\"content-block\" style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; vertical-align: top; margin: 0; padding: 0 0 20px;\" valign=\"top\">\n                                            Hi,\n                                        </td>\n                                    </tr>\n                                    <tr style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; margin: 0;\">\n                                        <td class=\"content-block\" style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; vertical-align: top; margin: 0; padding: 0 0 20px;\" valign=\"top\">\n                                            There is a course created by {{admin_name}} that requires approval. Please review below:\n                                        </td>\n                                    </tr>\n                                </table>\n                                <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-radius: 10px; padding: 10px; background-color: #F5F5F5;font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; margin: 0;\">\n                                    <tr\n                                        style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; margin: 0;\">\n                                        <span\n                                            style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; vertical-align: top; margin: 0; padding: 0 0 20px;\">Name</span>\n                                        <div\n                                            style=\"width: 80%; height: 45px; background-color: #ffffff; display: flex; align-items: center; padding-left: 5px; border-radius: 6px; margin-bottom: 18px;\">\n                                            {{admin_name}}\n                                        </div>\n                                    </tr>\n                                    <tr\n                                        style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; margin: 0;\">\n                                        <span\n                                            style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; vertical-align: top; margin: 0; padding: 0 0 20px;\">Email</span>\n                                        <div\n                                            style=\"width: 80%; height: 45px; background-color: #ffffff; display: flex; align-items: center; padding-left: 5px; border-radius: 6px; margin-bottom: 18px;\">\n                                            {{admin_email}}\n                                        </div>\n                                    </tr>\n                                    <tr\n                                        style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; margin: 0;\">\n                                        <span\n                                            style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; vertical-align: top; margin: 0; padding: 0 0 20px;\">Name\n                                            of language</span>\n                                        <div\n                                            style=\"width: 80%; height: 45px; background-color: #ffffff; display: flex; align-items: center; padding-left: 5px; border-radius: 6px; margin-bottom: 18px;\">\n                                            {{name}}\n                                        </div>\n                                    </tr>\n                                    <tr style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; margin: 0;\">\n                                        <span\n                                            style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; vertical-align: top; margin: 0; padding: 0 0 20px;\">Alternative\n                                            name</span>\n                                        <div\n                                            style=\"width: 80%; height: 45px; background-color: #ffffff; display: flex; align-items: center; padding-left: 5px; border-radius: 6px; margin-bottom: 18px;\">\n                                            {{alternative_name}}\n                                        </div>\n                                    </tr>\n                                    <tr style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; margin: 0;\">\n                                        <span\n                                            style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; vertical-align: top; margin: 0; padding: 0 0 20px;\">Language\n                                            Description</span>\n                                        <div\n                                            style=\"width: 80%; height: 45px; background-color: #ffffff; display: flex; align-items: center; padding-left: 5px; border-radius: 6px; margin-bottom: 18px;\">\n                                            {{description}}\n                                        </div>\n                                    </tr>\n                                    <tr style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; margin: 0;\">\n                                        <span\n                                            style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; vertical-align: top; margin: 0; padding: 0 0 20px;\">Teaching\n                                            Language</span>\n                                        <div\n                                            style=\"width: 80%; height: 45px; background-color: #ffffff; display: flex; align-items: center; padding-left: 5px; border-radius: 6px; margin-bottom: 18px;\">\n                                            {{translated_language}}\n                                        </div>\n                                    </tr>\n                                    <tr style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; margin: 0;\">\n                                        <span\n                                            style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; vertical-align: top; margin: 0; padding: 0 0 20px;\">ISO\n                                            Code</span>\n                                        <div\n                                            style=\"width: 80%; height: 45px; background-color: #ffffff; display: flex; align-items: center; padding-left: 5px; border-radius: 6px; margin-bottom: 18px;\">\n                                            {{iso}}\n                                        </div>\n                                    </tr>\n                                    <tr style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; margin: 0;\">\n                                        <span\n                                            style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; vertical-align: top; margin: 0; padding: 0 0 20px;\">Glotto\n                                            Code</span>\n                                        <div\n                                            style=\"width: 80%; height: 45px; background-color: #ffffff; display: flex; align-items: center; padding-left: 5px; border-radius: 6px; margin-bottom: 18px;\">\n                                            {{glotto}}\n                                        </div>\n                                    </tr>\n                                    <tr style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; margin: 0;\">\n                                        <span\n                                            style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; vertical-align: top; margin: 0; padding: 0 0 20px;\">Where\n                                            is this language spoken</span>\n                                        <div\n                                            style=\"width: 80%; height: 45px; background-color: #ffffff; display: flex; align-items: center; padding-left: 5px; border-radius: 6px; margin-bottom: 18px\">\n                                            {{location}}\n                                        </div>\n                                    </tr>\n                                    <tr style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; margin: 0;\">\n                                        <span\n                                            style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; vertical-align: top; margin: 0; padding: 0 0 20px;\">Approximately\n                                            how many people speak this language</span>\n                                        <div\n                                            style=\"width: 80%; height: 45px; background-color: #ffffff; display: flex; align-items: center; padding-left: 5px; border-radius: 6px; margin-bottom: 18px;\">\n                                            {{population}}\n                                        </div>\n                                    </tr>\n                                    <tr style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; margin: 0;\">\n                                        <span\n                                            style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; vertical-align: top; margin: 0; padding: 0 0 20px;\">Link\n                                            to additional information about this language</span>\n                                        <div\n                                            style=\"width: 80%; height: 45px; background-color: #ffffff; display: flex; align-items: center; padding-left: 5px; border-radius: 6px; margin-bottom: 18px;\">\n                                            {{link}}\n                                        </div>\n                                    </tr>\n                                    </table>\n\n                                    <div style=\"margin-top: 10px; display: flex; flex-direction: row; width: 100%; justify-content: center;\">\n\n                                        <form action=\"{{base_url}}/approve_or_reject_course?course_id={{id}}&decision=approve\" method=\"post\">\n                                            <input type=\"submit\" value=\"Approve\"\n                                                style=\"margin: 5px; color: white; font-size: 15px; font-weight: bold; width: 140px; height: 40px; border-style: solid; border-color: #DF4E47; background-color: #DF4E47; border-radius: 10px;\">\n                                        </form>\n\n                                        <form action=\"{{base_url}}/approve_or_reject_course?course_id={{id}}&decision=reject\" method=\"post\">\n                                            <input type=\"submit\" value=\"Reject\"\n                                                style=\"margin: 5px; color: #5B6165; font-size: 15px; font-weight: bold; width: 140px; height: 40px; border-style: solid; border-color: #DEE5E9; background-color: #DEE5E9; border-radius: 10px;\">\n                                        </form>\n                                        \n                                    </div>\n\n                                    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding: 10px; font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; margin: 0;\">\n                                    <tr style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; margin: 0;\">\n                                        <td class=\"content-block\" style=\"font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; vertical-align: top; margin: 0; padding: 0 0 0;\" valign=\"top\">\n                                            Sincerely, <br />\n                                            7000 Languages <br />\n                                            <img src=\"https://drive.google.com/uc?id=1tWuxv7hEI_9KEsUQBMZ95hzrbdvCmU5S\" />\n                                      